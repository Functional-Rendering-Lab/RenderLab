<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RenderLab.Gpu\RenderLab.Gpu.csproj" />
    <ProjectReference Include="..\RenderLab.Graph\RenderLab.Graph.csproj" />
    <ProjectReference Include="..\RenderLab.Platform.Desktop\RenderLab.Platform.Desktop.csproj" />
    <ProjectReference Include="..\RenderLab.Functional\RenderLab.Functional.csproj" />
    <ProjectReference Include="..\RenderLab.Scene\RenderLab.Scene.csproj" />
    <ProjectReference Include="..\RenderLab.Assets\RenderLab.Assets.csproj" />
    <ProjectReference Include="..\RenderLab.Project\RenderLab.Project.csproj" />
    <ProjectReference Include="..\RenderLab.Pipelines\RenderLab.Pipelines.csproj" />
    <ProjectReference Include="..\RenderLab.Editor\RenderLab.Editor.csproj" />
    <ProjectReference Include="..\RenderLab.Ui.ImGui\RenderLab.Ui.ImGui.csproj" />
    <ProjectReference Include="..\RenderLab.Ui\RenderLab.Ui.csproj" />
    <ProjectReference Include="..\RenderLab.Papers\RenderLab.Papers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\RenderLab.Shaders\**\*.spv" CopyToOutputDirectory="PreserveNewest" Link="shaders\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Per-project content: stage starter projects under bin/.../projects/{name}/
       so the loader can resolve them by relative path from the working dir. -->
  <ItemGroup>
    <Content Include="..\..\projects\**\*"
             CopyToOutputDirectory="PreserveNewest"
             Link="projects\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
